# Local development. Copy to .env; keep .env outside Git.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
IDENTITY_SERVICE_URL=http://127.0.0.1:8003
CUSTOMERS_SERVICE_URL=http://127.0.0.1:8001
WORKSHOP_SERVICE_URL=http://127.0.0.1:8002
# Generate a random secret of at least 32 characters, shared by all services.
INTERNAL_SERVICE_TOKEN=replace-with-a-random-secret-before-starting
POSTGRES_PASSWORD=replace-postgres-admin-password
IDENTITY_DB_PASSWORD=replace-identity-db-password
CUSTOMERS_DB_PASSWORD=replace-customers-db-password
WORKSHOP_DB_PASSWORD=replace-workshop-db-password
IDENTITY_DATABASE_URL=postgresql://identity:${IDENTITY_DB_PASSWORD}@127.0.0.1:5432/identity
CUSTOMERS_DATABASE_URL=postgresql://customers:${CUSTOMERS_DB_PASSWORD}@127.0.0.1:5432/customers
WORKSHOP_DATABASE_URL=postgresql://workshop:${WORKSHOP_DB_PASSWORD}@127.0.0.1:5432/workshop
# Isolated schemas are created and dropped by tests. Never point this at production.
TEST_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/postgres
DB_POOL_MAX_SIZE=10
IDENTITY_PRIVATE_KEY_PATH=data/jwt_private.pem
JWT_TTL_SECONDS=43200
ACTIVATION_TTL_SECONDS=86400
# Optional bootstrap administrator; disabled when these values are empty.
IDENTITY_BOOTSTRAP_ADMIN_PHONE=
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=
