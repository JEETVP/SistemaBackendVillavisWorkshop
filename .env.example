# Local development. Copy to .env; keep .env outside Git.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000
IDENTITY_SERVICE_URL=http://127.0.0.1:8003
CUSTOMERS_SERVICE_URL=http://127.0.0.1:8001
WORKSHOP_SERVICE_URL=http://127.0.0.1:8002
# Generate a random secret of at least 32 characters, shared by all services.
INTERNAL_SERVICE_TOKEN=replace-with-a-random-secret-before-starting
IDENTITY_DB_PATH=data/identity.db
CUSTOMERS_DB_PATH=data/customers.db
WORKSHOP_DB_PATH=data/workshop.db
IDENTITY_PRIVATE_KEY_PATH=data/jwt_private.pem
JWT_TTL_SECONDS=43200
ACTIVATION_TTL_SECONDS=86400
# Optional bootstrap administrator; disabled when these values are empty.
IDENTITY_BOOTSTRAP_ADMIN_PHONE=
IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
IDENTITY_BOOTSTRAP_ADMIN_PASSWORD=
